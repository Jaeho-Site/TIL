{
  "buildCommand": "npm run docs:build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "til-ruby.vercel.app" }],
      "destination": "https://notes.ezilog.dev/:path*",
      "permanent": true
    }
  ]
}
